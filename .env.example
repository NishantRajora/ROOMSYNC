# RoomSync Environment Configuration
# Copy this to .env and update values as needed

# Django backend
DJANGO_SECRET_KEY=change-this-to-a-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=*

# Admin credentials (demo only)
ROOMSYNC_ADMIN_EMAIL=admin@roomsync.test
ROOMSYNC_ADMIN_PASSWORD=Admin@1234

# Frontend (Vite)
VITE_ADMIN_EMAIL=admin@roomsync.test
VITE_ADMIN_PASSWORD=Admin@1234

# Blockchain (optional)
# HARDHAT_NETWORK=localhost
# CONTRACT_ADDRESS=0x...deployed-address
